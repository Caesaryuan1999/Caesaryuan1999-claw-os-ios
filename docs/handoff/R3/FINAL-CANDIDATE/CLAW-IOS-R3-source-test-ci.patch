+        XCTAssertTrue(flow.legacyLoginAvailable)
+        XCTAssertThrowsError(try awaitResult { flow.login(method: .email, input: "a@b.com", password: "old", completion: $0) }.get())
+        XCTAssertTrue(committed.isEmpty)
+    }
+

+        var delta = ClawAssistantSSEParser()
+        XCTAssertThrowsError(try delta.append(AssistantBFixture.frame(AssistantBFixture.event("1", text: String(repeating: "a", count: 4097)))))
+        var utf8 = ClawAssistantSSEParser()
